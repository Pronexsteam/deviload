{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "node scripts/prepare-appimage.mjs"
  },
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "resources": {
      "../bin/yt-dlp": "bin/yt-dlp",
      "../bin/ffmpeg": "bin/ffmpeg",
      "../bin/ffprobe": "bin/ffprobe",
      "../bin/deno": "bin/deno",
      "../LICENSES/*": "LICENSES/"
    },
    "linux": {
      "deb": {
        "section": "video",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "createUpdaterArtifacts": true
  }
}
