{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deviload",
  "version": "2.4.0",
  "identifier": "com.deviload.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Deviload",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://i.ytimg.com; connect-src ipc: http://ipc.localhost; media-src 'self' data: asset: http://asset.localhost https://asset.localhost",
      "assetProtocol": {
        "scope": [],
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNzZDOTZCNDM3NjRGNTYKUldSV1QzWkRhOGwyOFl0bENldk1QVnlKS1g1cnQ0THFVa3ZucnpQSVhyeEQ3azJxdlYwVW0zbisK",
      "endpoints": [
        "https://raw.githubusercontent.com/Pronexsteam/deviload/updates/latest.json",
        "https://github.com/Pronexsteam/deviload/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
